---
import Observatory from './Observatory.astro';
import { SOCIALS } from '../data/site';
import now from '../data/now.json';
---

<section class="hero">
  <div class="wrap grid">
    <div class="intro">
      <p class="kicker">SYSTEMS · STORAGE · INFRASTRUCTURE</p>
      <!-- PLACEHOLDER: hero statement — user rewrites final copy -->
      <h1>Building autonomous storage for machines the size of warehouses.</h1>
      <p class="lede">
        Systems Software Engineer at Hewlett Packard Enterprise — distributed storage,
        orchestration, and exascale HPC.
      </p>
      <div class="now mono">
        <p><span class="dot" aria-hidden="true">●</span> NOW — {now.now}</p>
        <p><span class="dot" aria-hidden="true">●</span> EXPLORING — {now.exploring}</p>
      </div>
      <ul class="socials mono">
        {
          SOCIALS.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener' : undefined}
              >
                {label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <Observatory />
  </div>
</section>

<style>
  /* cosmic atmosphere — hero only (DESIGN.md §9) */
  .hero {
    background:
      radial-gradient(ellipse 60% 50% at 78% 18%, rgba(116, 165, 218, 0.07), transparent 70%),
      radial-gradient(1px 1px at 12% 20%, rgba(234, 227, 210, 0.5), transparent 100%),
      radial-gradient(1px 1px at 30% 8%, rgba(234, 227, 210, 0.35), transparent 100%),
      radial-gradient(1.5px 1.5px at 48% 26%, rgba(234, 227, 210, 0.3), transparent 100%),
      radial-gradient(1px 1px at 64% 6%, rgba(234, 227, 210, 0.4), transparent 100%),
      radial-gradient(1px 1px at 86% 40%, rgba(234, 227, 210, 0.35), transparent 100%),
      radial-gradient(1px 1px at 94% 12%, rgba(234, 227, 210, 0.45), transparent 100%);
  }

  .grid {
    display: grid;
    grid-template-columns: 56% 1fr;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    align-items: stretch;
  }

  .kicker {
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: var(--text-display);
    margin-bottom: 1.25rem;
    max-width: 16ch;
  }

  .lede {
    color: var(--ink-muted);
    max-width: 44ch;
    margin-bottom: 1.75rem;
  }

  .now {
    border-left: 2px solid var(--accent);
    padding-left: 0.9rem;
    margin-bottom: 1.9rem;
    color: var(--ink-muted);
    text-transform: none;
    line-height: 2;
  }

  .now .dot {
    color: var(--accent);
    font-size: 0.5rem;
    vertical-align: middle;
    margin-right: 0.35rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    padding: 0;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
