---
import Observatory from './Observatory.astro';
import { SOCIALS } from '../data/site';
import now from '../data/now.json';
---

<section class="hero">
  <Observatory />
  <div class="wrap grid">
    <div class="intro">
      <p class="kicker">SYSTEMS · STORAGE · INFRASTRUCTURE · SECURITY</p>
      <!-- PLACEHOLDER: hero statement — user rewrites final copy -->
      <h1>I work on the systems, infrastructure, and security behind machines at scale.</h1>
      <p class="byline">
        <span class="serif who">— Bipin Raj C</span>
        <span class="role">· Systems Software Engineer, Hewlett Packard Enterprise</span>
      </p>
      <div class="now mono">
        <p><span class="dot" aria-hidden="true">●</span> NOW — {now.now}</p>
        <p><span class="dot" aria-hidden="true">●</span> EXPLORING — {now.exploring}</p>
      </div>
      <ul class="socials mono">
        {
          SOCIALS.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener' : undefined}
              >
                {label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* the Observatory bleeds in from the right edge at full hero height;
     the text floats above the scene's dark left zone */
  .hero {
    position: relative;
    overflow: clip;
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 58%);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .kicker {
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: var(--text-display);
    margin-bottom: 1.25rem;
    max-width: 16ch;
  }

  /* editorial byline — authorship of the statement */
  .byline {
    margin-bottom: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .byline .who {
    font-size: 1.25rem;
    font-style: italic;
  }

  .byline .role {
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  .now {
    border-left: 2px solid var(--accent);
    padding-left: 0.9rem;
    margin-bottom: 1.9rem;
    color: var(--ink-muted);
    text-transform: none;
    line-height: 2;
  }

  .now .dot {
    color: var(--accent);
    font-size: 0.5rem;
    vertical-align: middle;
    margin-right: 0.35rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    padding: 0;
  }

  @media (max-width: 900px) {
    /* statement first, Observatory below — never above the name */
    .hero {
      display: flex;
      flex-direction: column;
    }

    .grid {
      grid-template-columns: 1fr;
      order: 1;
    }
  }
</style>
