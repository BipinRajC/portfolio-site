---
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  project: {
    title: string;
    description: string;
    date: Date;
    domain: string[];
    capability: string[];
    workType: string[];
    github?: string;
    deployed?: string;
    thumbnail?: string;
    visual?: { type: string; source?: string; alt?: string };
  };
  slug: string;
}
const { project, slug } = Astro.props;
const tags = [...project.domain, ...project.capability, ...project.workType];
const fmtDate = project.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="entry" data-project-id={slug}>
  <a class="entry-link" href={`/projects/${slug}`}>
    <ProjectVisual visual={{ ...project.visual, source: project.thumbnail ?? project.visual?.source }} />
  </a>
  <div class="entry-body">
    <p class="meta mono">{fmtDate}</p>
    <div class="title-row">
      <a class="title-link" href={`/projects/${slug}`}>
        <h3 class="serif">{project.title}</h3>
      </a>
      <div class="icons">
        {project.github && (
          <a class="icon" href={project.github} target="_blank" rel="noopener" aria-label={`${project.title} on GitHub`}>
            <img src="/github-logo.png" alt="" width="25" height="25" class="gh-img" />
          </a>
        )}
        {project.deployed && (
          <a class="icon" href={project.deployed} target="_blank" rel="noopener" aria-label={`${project.title} live site`}>
            <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        )}
      </div>
    </div>
    <p class="desc">{project.description}</p>
    <p class="tags mono">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </p>
  </div>
</article>

<style>
  .entry { padding-block: 3rem; }
  .entry-link { display: block; text-decoration: none; border-bottom: none; }
  .entry-body { margin-top: 1.25rem; }
  .meta { color: var(--support); font-size: 0.65rem; margin-bottom: 0.4rem; }
  .title-row { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .title-link { text-decoration: none; border-bottom: none; }
  .entry h3 { font-size: var(--text-title); color: var(--ink); }
  .icons { display: flex; align-items: center; gap: 0.7rem; }
  /* enlarged tap target; negative margin keeps the visual 25px glyph position */
  .icon { display: inline-flex; align-items: center; color: var(--support); border-bottom: none; padding: 0.6rem; margin: -0.6rem; }
  .icon:hover { color: var(--accent); }
  .gh-img { filter: invert(1); }
  .desc { color: var(--ink-muted); max-width: 60ch; line-height: 1.6; margin-bottom: 0.9rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; color: var(--support); font-size: 0.62rem; }
  .tag { color: var(--support); }
  .title-link:hover h3 { color: var(--accent); }
</style>
