---
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  project: {
    title: string;
    description: string;
    date: Date;
    domain: string[];
    capability: string[];
    workType: string[];
    github?: string;
    visual?: { type: string; source?: string; alt?: string };
  };
  slug: string;
}
const { project, slug } = Astro.props;
const tags = [...project.domain, ...project.capability, ...project.workType];
const fmtDate = project.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="entry">
  <a class="entry-link" href={`/projects/${slug}`}>
    <ProjectVisual visual={project.visual} />
    <div class="entry-body">
      <p class="meta mono">{fmtDate}</p>
      <h3 class="serif">{project.title}</h3>
      <p class="desc">{project.description}</p>
      <p class="tags mono">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </p>
    </div>
  </a>
  {project.github && (
    <a class="gh mono" href={project.github} target="_blank" rel="noopener" aria-label={`${project.title} on GitHub`}>
      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  )}
</article>

<style>
  .entry { border-top: 1px solid var(--line); padding-block: 2rem; }
  .entry-link { display: grid; gap: 1.25rem; text-decoration: none; }
  .meta { color: var(--support); font-size: 0.65rem; }
  .entry h3 { font-size: var(--text-title); margin-bottom: 0.5rem; color: var(--ink); }
  .desc { color: var(--ink-muted); max-width: 60ch; line-height: 1.6; margin-bottom: 0.9rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; color: var(--support); font-size: 0.62rem; }
  .tag { color: var(--support); }
  .gh { display: inline-flex; align-items: center; color: var(--support); margin-top: 0.6rem; }
  .gh:hover { color: var(--accent); }
  .entry-link:hover h3 { color: var(--accent); }
</style>
