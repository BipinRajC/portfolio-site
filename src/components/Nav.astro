---
const LINKS = [
  { label: 'EXPERIENCE', href: '/experience' },
  { label: 'PROJECTS', href: '/projects' },
  { label: 'NOTES', href: '/notes' },
  { label: 'ABOUT', href: '/about' },
  { label: 'TRAJECTORY', href: '/trajectory' },
  { label: 'CONTACT', href: '/contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header>
  <div class="wrap bar">
    <a class="name serif" href="/">Bipin Raj C</a>
    <nav aria-label="Main">
      <ul class="mono">
        {
          LINKS.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.1rem;
  }

  /* masthead — the heaviest element in the header (DESIGN.md §7) */
  .name {
    color: var(--ink);
    border-bottom: none;
    font-size: 1.55rem;
    letter-spacing: 0.01em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--ink-muted);
    border-bottom: none;
    transition: color 150ms ease;
    display: inline-block;
    padding: 0.4rem 0.1rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  /* mobile: masthead row, then the six links as an exposed 3-column grid —
     no hamburger, no hidden navigation (DESIGN.md §7/§11, user-approved 2026-10-13) */
  @media (max-width: 640px) {
    .bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 1rem 0;
    }

    .name {
      padding-block: 0.25rem 1rem;
    }

    ul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      justify-items: start;
      gap: 0 0.25rem;
      padding-block: 0.4rem 0.75rem;
      border-top: 1px solid var(--line);
    }

    nav a {
      display: block;
      padding: 0.75rem 0.2rem;
      font-size: 0.68rem;
      letter-spacing: 0.1em; /* slightly tightened so ten-char labels fit 320px columns */
    }
  }
</style>
