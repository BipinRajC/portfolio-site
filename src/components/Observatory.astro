---
/**
 * Builder's Observatory — hero artwork.
 * Fine-grain Bayer 8×8 duotone dither (scripts/build-observatory.py):
 * amber mid-tone dots, ivory highlights, warm core at the lamp,
 * transparent shadows — the cosmic background shows through the scene's
 * darkness, so the Observatory emerges from the same sky.
 * Layout: bleeds in from the right edge at full hero height on desktop,
 * dissolving toward the text; a normal block below the text on mobile.
 * Asset: /observatory.png (palette PNG, 1040×693 = 2× display).
 */
---

<figure
  class="obs"
  role="img"
  aria-label="Fine-dither illustration: a builder at a multi-monitor workstation inside a dark observatory, a round window opening to a starry sky"
>
  <img
    src="/observatory.png"
    width="1536"
    height="1024"
    alt=""
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
  <figcaption class="mono">FIG. 01 — THE BUILDER'S OBSERVATORY</figcaption>
</figure>

<style>
  .obs {
    position: absolute;
    inset: 0 var(--pad-x) 0 auto;
    width: 54%;
    margin: 0;
    pointer-events: none;
  }

  /* contain, never crop: the whole scene is visible, hugging the
     viewport's right edge, vertically centered in the hero */
  .obs img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
  }

  /* only a faint corner quiet-zone for the caption — the dissolve is
     baked into the artwork itself (edge fade → transparent dots), so
     the sky stays visible through the scene everywhere else */
  .obs::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 32% 22% at 84% 96%,
      rgba(10, 15, 24, 0.55),
      transparent 70%
    );
  }

  figcaption {
    position: absolute;
    right: var(--pad-x);
    bottom: 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .obs {
      position: static;
      width: 100%;
      order: 2;
    }

    .obs img {
      height: auto;
      max-height: 340px;
    }

    /* no desktop dissolve on mobile — the art stands alone below the text */
    .obs::after {
      display: none;
    }

    figcaption {
      position: static;
      text-align: center;
      margin-top: 0.4rem;
    }
  }
</style>
