---
interface Props {
  visual?: { type?: string; source?: string; alt?: string };
  caption?: string;
  large?: boolean;
}
const { visual, caption, large } = Astro.props;
const src = visual?.source;
const alt = visual?.alt ?? '';
---

<figure class:list={['visual', { large }]}>
  {src ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <div class="placeholder" aria-hidden="true"></div>
  )}
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .visual {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
  }
  .visual img {
    display: block;
    width: 100%;
    height: auto;
  }
  .placeholder {
    aspect-ratio: 16 / 9;
    background: var(--bg-panel);
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--support);
    font-size: 0.6rem;
    letter-spacing: var(--track-meta);
  }
</style>
