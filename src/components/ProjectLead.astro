---
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  project: { title: string; description: string; date: Date; domain: string[]; capability: string[]; workType: string[]; github?: string; deployed?: string; thumbnail?: string; visual?: { type?: string; source?: string; alt?: string } };
  slug: string;
}
const { project, slug } = Astro.props;
const tags = [...project.domain, ...project.capability, ...project.workType];
const fmtDate = project.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article class="lead" data-project-id={slug}>
  <a class="lead-link" href={`/projects/${slug}`}>
    <ProjectVisual visual={{ ...project.visual, source: project.thumbnail ?? project.visual?.source }} large />
  </a>
  <div class="lead-body">
    <p class="meta mono">{fmtDate}</p>
    <div class="title-row">
      <a class="title-link" href={`/projects/${slug}`}>
        <h2 class="serif">{project.title}</h2>
      </a>
      <div class="icons">
        {project.github && (
          <a class="icon" href={project.github} target="_blank" rel="noopener" aria-label={`${project.title} on GitHub`}>
            <img src="/github-logo.png" alt="" width="25" height="25" class="gh-img" />
          </a>
        )}
        {project.deployed && (
          <a class="icon" href={project.deployed} target="_blank" rel="noopener" aria-label={`${project.title} live site`}>
            <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        )}
      </div>
    </div>
    <p class="desc">{project.description}</p>
    <p class="tags mono">{tags.map((t) => <span class="tag">{t}</span>)}</p>
  </div>
</article>

<style>
  .lead { padding-block: 2.5rem; }
  .lead-link { display: block; text-decoration: none; border-bottom: none; }
  .lead-body { margin-top: 1.5rem; }
  .meta { color: var(--support); font-size: 0.65rem; margin-bottom: 0.4rem; }
  .title-row { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .title-link { text-decoration: none; border-bottom: none; }
  .lead h2 { font-size: var(--text-display); color: var(--ink); }
  .icons { display: flex; align-items: center; gap: 0.7rem; }
  .icon { display: inline-flex; align-items: center; color: var(--support); border-bottom: none; }
  .icon:hover { color: var(--accent); }
  .gh-img { filter: invert(1); }
  .desc { color: var(--ink-muted); max-width: 62ch; line-height: 1.7; margin-bottom: 1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; color: var(--support); font-size: 0.62rem; }
  .tag { color: var(--support); }
  .title-link:hover h2 { color: var(--accent); }
</style>
