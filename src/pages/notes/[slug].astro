---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toISOString().slice(0, 10);
---

<Base title={note.data.title} description={note.data.description ?? note.data.title}>
  <article class="wrap">
    <header class="head">
      <p class="meta mono">
        {date}{note.data.tags.length > 0 && ` · ${note.data.tags.join(' · ')}`}
      </p>
      <h1 class="serif">{note.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back mono"><a href="/notes">← NOTES</a></p>
  </article>
</Base>

<style>
  .head {
    padding-block: var(--space-section) 2.5rem;
  }

  .meta {
    color: var(--support);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 22ch;
  }

  .back {
    margin-top: 3.5rem;
  }
</style>
