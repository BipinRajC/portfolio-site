---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter((p) => p.data.atlas && !p.data.draft);
---

<Base title="Projects">
  <div class="wrap">
    <h1 class="serif">Projects</h1>
    <ul>
      {projects.map((p) => (
        <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>
      ))}
    </ul>
  </div>
</Base>
