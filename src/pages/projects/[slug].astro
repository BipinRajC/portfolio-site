---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, status, tech, links } = project.data;

const month = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
const metaLine = [status.toUpperCase(), month, ...tech.map((t) => t.toUpperCase())].join(' · ');
const external = [
  links.github && { label: 'GITHUB', href: links.github },
  links.paper && { label: 'PAPER', href: links.paper },
  links.demo && { label: 'DEMO', href: links.demo },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={title} description={description}>
  <article class="wrap">
    <header class="head">
      <p class="meta mono">{metaLine}</p>
      <h1 class="serif">{title}</h1>
      <p class="lede">{description}</p>
      {
        external.length > 0 && (
          <ul class="links mono">
            {external.map(({ label, href }) => (
              <li>
                <a href={href} target="_blank" rel="noopener">
                  {label} ↗
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back mono"><a href="/projects">← PROJECTS</a></p>
  </article>
</Base>

<style>
  .head {
    padding-block: var(--space-section) 2.5rem;
  }

  .meta {
    color: var(--support);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 0.8rem;
  }

  .lede {
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
  }

  .back {
    margin-top: 3.5rem;
  }
</style>
