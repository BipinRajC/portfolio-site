---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Nothing at these coordinates.">
  <div class="void">
    <p class="err mono">ERR 404 — OBJECT NOT FOUND</p>
    <h1 class="serif">Nothing at these coordinates.</h1>
    <p class="back mono"><a href="/">← HOME</a></p>
  </div>
</Base>

<style>
  /* the site-wide Atmosphere provides the sky */
  .void {
    min-height: 60vh;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 1.1rem;
    padding-inline: var(--pad-x);
  }

  .err {
    color: var(--support);
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
</style>
